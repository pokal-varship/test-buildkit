{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "types": ["node"],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@config/*": ["config/*"],
      "@services/*": ["services/*"],
      "@components/*": ["components/*"],
      "@app/*": ["app/*"],
      "@styles/*": ["styles/*"],
      "@hooks/*": ["hooks/*"],
      "@lib/*": ["lib/*"],
      "@redux/*": ["redux/*"],
      "@context/*": ["context/*"]
    },
    "baseUrl": "."
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "stories/AddressInput.stories.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
